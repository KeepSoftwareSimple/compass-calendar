{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "target": "es6",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["bun-types"],
    "paths": {
      "@booking-web/*": ["./src/*"],
      "@web/*": ["../../packages/web/src/*"],
      "@web-build/*": ["../../packages/web/*"],
      "@core/*": ["../../packages/core/src/*"]
    },
    "lib": ["ES6", "dom"]
  }
}
