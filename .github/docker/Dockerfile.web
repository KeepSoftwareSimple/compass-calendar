FROM oven/bun:1.3.14 AS build

WORKDIR /app

# Install before COPY . . so source edits do not bust the install layer.
COPY package.json bun.lock bunfig.toml ./
COPY patches ./patches
COPY packages/backend/package.json packages/backend/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/scripts/package.json packages/scripts/package.json
COPY packages/sync/package.json packages/sync/package.json
COPY packages/web/package.json packages/web/package.json
COPY apps/booking-web/package.json apps/booking-web/package.json
RUN bun install --frozen-lockfile
COPY . .

ARG BASEURL=http://localhost:3000/api
ARG GOOGLE_CLIENT_ID=
ARG MICROSOFT_CLIENT_ID=
ARG APPLE_SERVICES_ID=
ARG POSTHOG_KEY=
ARG POSTHOG_HOST=
ARG COMPASS_BUILD_REF=self-host
ARG NODE_ENV=production

ENV COMPASS_BUILD_REF=${COMPASS_BUILD_REF}
ENV NODE_ENV=${NODE_ENV}
ENV WEB_PORT=9080
ENV MICROSOFT_CLIENT_ID=${MICROSOFT_CLIENT_ID}
ENV APPLE_SERVICES_ID=${APPLE_SERVICES_ID}

RUN printf '%s\n' \
  'runtime:' \
  "  nodeEnv: ${NODE_ENV}" \
  '  timezone: Etc/UTC' \
  'web:' \
  '  url: http://localhost:9080' \
  'backend:' \
  "  apiUrl: ${BASEURL}" \
  '  compassToken: unused-web-build' \
  'mongo:' \
  '  uri: mongodb://localhost:27017/unused' \
  'supertokens:' \
  '  uri: http://localhost:3567' \
  '  key: unused-web-build' \
  'google:' \
  "  clientId: ${GOOGLE_CLIENT_ID}" \
  > compass.yaml

RUN if [ -n "$POSTHOG_KEY" ] && [ -n "$POSTHOG_HOST" ]; then \
  printf '%s\n' \
    'posthog:' \
    "  key: ${POSTHOG_KEY}" \
    "  host: ${POSTHOG_HOST}" \
    >> compass.yaml; \
  fi

RUN cd packages/web && bun run build.ts

FROM oven/bun:1.3.14-slim AS runtime

WORKDIR /app

# groupadd/useradd, not addgroup/adduser: Debian 13 (trixie) based
# oven/bun slim images no longer ship the adduser package.
RUN groupadd --system --gid 1001 compass \
 && useradd --system --uid 1001 --gid compass --no-create-home --shell /usr/sbin/nologin compass

ENV WEB_PORT=9080
ENV WEB_ROOT=/app/build/web

COPY --from=build --chown=compass:compass /app/build/web ./build/web
# serve-web.ts imports this map at runtime, so the runtime stage needs the
# file on disk; without it bun exits on an unresolved module and the web
# container restart-loops.
COPY --from=build --chown=compass:compass /app/packages/web/compressible-static-types.ts ./packages/web/compressible-static-types.ts
COPY --from=build --chown=compass:compass /app/self-host/serve-web.ts ./self-host/serve-web.ts

USER compass

EXPOSE 9080
CMD ["bun", "self-host/serve-web.ts"]
